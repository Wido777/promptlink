{
  "manifest_version": 3,
  "name": "promptlink",
  "short_name": "promptlink",
  "version": "0.4.1",
  "description": "Shows when a web page hides instructions aimed at AI, or links to an AI assistant with a poisoned prompt. Runs locally.",
  "homepage_url": "https://github.com/Wido777/promptlink",
  "permissions": [
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "promptlink",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/rules.js",
        "lib/promptlink.js",
        "lib/page.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "promptlink@wido777.github.io",
      "strict_min_version": "121.0"
    }
  }
}
